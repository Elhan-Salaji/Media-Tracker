# Base URL of the backend API as the browser sees it. Vite writes the value into the bundle
# at build time, so a change needs a new build. Without the variable the frontend uses
# http://localhost:8080 (see vite.config.ts).
VITE_API_BASE_URL=http://localhost:8080

# No API key belongs in a VITE_ variable. Vite writes every VITE_ value into the
# bundle at build time, so anyone who opens the app can read it. Keys stay in
# backend/.env, and the backend sends them to the search APIs.
