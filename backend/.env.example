# Copy this file to backend/.env and fill in every value. git ignores .env files.
# A local run of the backend reads backend/.env, and Docker Compose passes it to the backend container.

# Signing secret for the JWT access and refresh tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# API key for the RAWG game search, free at https://rawg.io/apidocs
RAWG_API_KEY=

# Optional. User-Agent for every request to the search APIs. Open Library asks for the application name
# and a contact e-mail, and lets identified clients send three requests per second instead of one.
# Without this line the backend sends MediaTracker/<version> (+https://github.com/Elhan-Salaji/Media-Tracker).
# An empty value stops the backend at startup.
# HTTP_USER_AGENT=MediaTracker/1.1.1 (you@example.com)
